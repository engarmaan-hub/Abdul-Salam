!=====================================================================
! 3-D abutment / protection cone / soil  --  thermal transient
! Corrected version of the original script.  Changes are tagged
! "!>>> FIX".  Boundary-function tables are unchanged.
!=====================================================================
/CLEAR
/config,nres,200000
wpcsys,,0
/prep7
wprota,,90
ET,1,solid70
et,2,mesh200,6

! ---- switches (new) -------------------------------------------------
TCC_SOIL = 1.0E7      !>>> FIX cone <-> natural ground: perfect contact [J/(h*m2*C)]
TCC_ABUT = 105840     ! cone <-> abutment concrete (your value, 29.4 W/m2K)
KEEP_NODE_PATCH = 0   !>>> FIX 1 = re-apply the old hard-coded node lists
RUN_YEARS = 0         !>>> 0 = your original run (1850 h, 2000 h); n = run n years

!! Natural Ground Surface
*DEL,_FNCNAME
*DEL,_FNCMTID
*DEL,_FNCCSYS
*SET,_FNCNAME,'dibiao'
*SET,_FNCCSYS,0
*DIM,%_FNCNAME%,TABLE,6,17,1,,,,%_FNCCSYS%
! equation: -0.48+11*sin(2*PI*TIME/8760+PI)+0.00000594*TIME
