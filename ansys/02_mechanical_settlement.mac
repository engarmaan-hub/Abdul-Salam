!=======================================================================
! 02_mechanical_settlement.mac
!
! Sequential thermo-mechanical analysis - STEP 2 (structural)
! Freeze-thaw settlement of the embankment / bridge-abutment transition
! following Chen et al., Eng. Fail. Anal. 163 (2024) 108476:
!   Eq.4  eps_k = alpha (thawed), 0 (frozen)   thaw settlement strain
!   Eq.5  eps_c = A s^B t^C e^(-D/T)           creep of frozen soil
!   Eq.6  E     = a1 + b1|T|^m
!   Eq.7  nu    = a2 + b2|T|
!   Eq.8  c     = a3 + b3|T|
!   Eq.9  phi   = a4 + b4|T|                   (Table 3 constants)
!
! Needs from STEP 1 (01_thermal_transient.mac, jobname THERMAL):
!   THERMAL.db   same mesh, materials, contact pairs, XL, YB, ICT
!   THERMAL.rth  nodal temperatures at the end of every month
! Results are extracted with 03_extract_results.mac.
!
! Units: m, kg, N, Pa. Time in HOURS, the same clock as the thermal run
! (t = 0 mid-October; October of year N = N*8760 h).
!
! Load steps
!   LS1  t=0.5  ground self weight only (geostatic stress). Embankment,
!               abutment and crushed rock are weightless. REFERENCE STATE:
!               settlement is measured from here, as in Fig. 14.
!   LS2  t=0.75 embankment + abutment weight, pavement + traffic load
!               (temperatures unchanged from LS1)
!   LS3  t=1    initial temperature field ICT (end of construction)
!   LS4+ t=730k monthly temperature fields from THERMAL.rth
!=======================================================================
/CLEAR
/FILNAME,MECH,1
RESUME,'THERMAL','db'
*AFUN,RAD
PI=3.14159265358979

!---------------------------- switches ---------------------------------
NMON      = NYEAR*12 ! NYEAR, XL, YB, ICT come from THERMAL.db
MSTEP     = 1        ! solve every MSTEP months (1 = monthly, 2, 3, 6, 12)
THAW_REF  = 0        ! 0 = PAPER: thaw strain measured from the frozen state
                     !     for every soil (Eq.4 as written: eps = alpha
                     !     whenever T > 0, including the active layer and the
                     !     fill that is thawed at t = 0)
                     ! 1 = soil that is thawed at t = 0 starts strain-free
IRREV     = 0        ! 0 = PAPER: strain follows the current temperature
                     ! 1 = thaw strain never recovers (no frost heave);
                     !     soil props then use the highest T reached
THS_1     = 0.0      ! thaw strain starts   (degC)  alpha = 0 below 0 degC
THS_2     = 0.1      ! thaw strain complete (degC)  short ramp, convergence
VERT_ONLY = 1        ! 1 = thaw strain vertical only (1-D thaw consolidation)
FILL_THAW = 1        ! 1 = PAPER: fill gets alpha = 1 % (Table 3, cobbly soil)
                     ! 0 = fill placed unfrozen has no ice -> no thaw strain
USE_CREEP = 1        ! 1 = frozen-soil creep, Eq.5
SIG_U     = 1000     ! Pa per stress unit of the creep law (1000 = kPa)
TIM_U     = 1        ! hours per time unit of the creep law (1 = h)
T_CLMP    = 0.1      ! |T| floor in exp(-D/T), avoids blow-up at 0 degC
M_E       = 1.0      ! exponent m in Eq.6 - NOT given in the paper
C_MIN     = 5e3      ! minimum cohesion (Pa) so cohesionless soil converges
PHI_MX    = 50       ! cap on Eq.9 friction angle (deg)
!---- surcharge on the road surface (see docs/Model_Note.md, Sec. 7)
LOAD_CASE = 1        ! 1 = PAPER: 60.1 kPa "dynamic load as static load"
                     ! 2 = realistic long-term: pavement dead load + traffic
                     !     equivalent soil column (JTG D30 / D60, 550 kN)
                     ! 3 = user values below
Q_PAVE    = 0        ! pavement layers dead load (Pa)       (case 3)
Q_VEH     = 0        ! vehicle equivalent uniform load (Pa)  (case 3)
*IF,LOAD_CASE,EQ,1,THEN
  Q_PAVE = 0
  Q_VEH  = 60.1e3
*ELSEIF,LOAD_CASE,EQ,2
  Q_PAVE = 16.4e3    ! 0.18 m AC + 0.36 m CTB + 0.20 m subbase
  Q_VEH  = 17.9e3    ! 550 kN / (2.4 m x 12.8 m), one lane loaded
*ENDIF
Q_TRAF    = Q_PAVE+Q_VEH
LOAD_CAP  = 1        ! 1 = also on the road over the abutment cap (line 2)
CR_E      = 100e6    ! crushed-rock layer (mat 11) modulus, if USE_CR = 1
!---- contact / support of the abutment (fix for the rigid-body error)
ABUT_BOND = 1        ! 1 = footing and front pairs bonded (foundation cast
                     !     in the ground); behind pair stays standard, so
                     !     the embankment can still separate (paper)
                     ! 0 = all pairs standard frictional (can float!)
FKN_M     = 1.0      ! contact normal stiffness factor in the structural run
                     ! (the thermal database has 0.01 = 100x too soft)
SEAT_FIX  = 0        ! 1 = UX = 0 at the bridge seat (superstructure restrains
                     !     the abutment horizontally, fixed bearing)
STAB      = 0        ! 1 = energy stabilisation if a step will not converge

!------------------ Table 3 constants, one column per material ----------
! row 1 a1  2 b1 (E, MPa)   3 a2  4 b2 (nu)   5 a3  6 b3 (c, MPa)
!     7 a4  8 b4 (phi, deg) 9 alpha (thaw settlement coefficient, %)
!    10 A  11 B  12 C  13 D (creep)
!    14 thawed at t = 0 (1 = yes: active layer, embankment fill)
*DEL,MPT
*DIM,MPT,ARRAY,14,5
MPT(1,1) = 34, 30, 0.42,-0.007, 0.00, 0.600, 31     ! mat 1 gravel soil
MPT(8,1) = 4.0, 1, 2e-14, 2.06, 0.32, 0.10, 1
MPT(1,2) = 36, 30, 0.42,-0.007, 0.00, 0.600, 31     ! mat 2 sandy soil
MPT(8,2) = 4.0, 5, 2e-14, 2.06, 0.32, 0.10, 1
MPT(1,3) = 28, 26, 0.40,-0.008, 0.15, 0.090, 22     ! mat 3 sub-clay
MPT(8,3) = 8.0, 12, 2.98e-7, 1.07, 0.07, 0.52, 0
MPT(1,4) = 140, 108, 0.25,-0.004, 0.10, 0.240, 28   ! mat 4 weathered mudstone
MPT(8,4) = 11.0, 1, 2.86e-7, 1.07, 0.06, 0.52, 0
MPT(1,5) = 61, 53, 0.35,-0.007, 0.03, 0.094, 23     ! mat 5 embankment fill
MPT(8,5) = 9.5, 1, 3.68e-7, 1.18, 0.08, 0.54, 1     !       = cobbly soil

! temperature points for E, nu, c, phi and creep
*DEL,TPT
*DIM,TPT,ARRAY,18
TPT(1)  = -20,-15,-10,-7.5,-5,-4,-3,-2,-1.5
TPT(10) = -1,-0.75,-0.5,-0.3,-0.2,-0.1,0,1,40
NT = 18
T_FRZ = -1.0         ! a frozen temperature: thaw strain = 0 here

!======================= element and material change ====================
/PREP7
DDELE,ALL,TEMP             ! thermal boundary conditions out
SFDELE,ALL,HFLUX
ICDELE

ETCHG,TTS                  ! PLANE55 -> PLANE182
KEYOPT,1,1,0               ! full integration, B-bar
KEYOPT,1,3,2               ! PLANE STRAIN (ETCHG leaves plane stress)
KEYOPT,2,1,0               ! CONTA172: UX, UY instead of TEMP
KEYOPT,2,9,1               ! ignore initial gap / penetration
KEYOPT,2,10,2              ! update contact stiffness every iteration
KEYOPT,2,12,0              ! standard: embankment may separate (paper)
! Friction MU (mat 8/9/10) and cohesion (real sets 8/9/10) come over from
! the thermal database. The thermal run used FKN = 0.01 (only TCC matters
! there); structurally that lets the abutment sink ~0.2 m into the soil
! by penetration alone, so the normal stiffness factor is reset here.
RMODIF,8,3,FKN_M
RMODIF,9,3,FKN_M
RMODIF,10,3,FKN_M
! The concrete (abutment + footing) has its own nodes and is held ONLY by
! contact. Coincident surfaces start "just touching" = open for standard
! contact, so the weightless concrete floats in LS1 (pivot warnings) and
! falls when its weight is switched on (UY > 1e6, rigid-body error).
! Fix: bonded contact for the footing (real 10) and front (real 9) pairs,
! on their own element type because KEYOPTs belong to the element type.
*IF,ABUT_BOND,EQ,1,THEN
  ET,4,CONTA172
  KEYOPT,4,1,0
  KEYOPT,4,2,0             ! augmented Lagrange (penalty) - no MPC
                           ! over-constraint at shared corner nodes
  KEYOPT,4,9,1
  KEYOPT,4,10,2
  KEYOPT,4,12,5            ! bonded (always)
  ESEL,S,TYPE,,2
  ESEL,R,REAL,,9,10
  EMODIF,ALL,TYPE,4
  ALLSEL,ALL
*ENDIF

MPDELE,EX,1,11
MPDELE,PRXY,1,11
MPDELE,ALPX,1,11
TBDELE,ALL,1,11

*DO,MI,1,5
  A1 = MPT(1,MI)
  B1 = MPT(2,MI)
  A2 = MPT(3,MI)
  B2 = MPT(4,MI)
  A3 = MPT(5,MI)
  B3 = MPT(6,MI)
  A4 = MPT(7,MI)
  B4 = MPT(8,MI)
  DELA = MPT(9,MI)/100
  *IF,MI,EQ,5,THEN
    DELA = DELA*FILL_THAW
  *ENDIF
  THW0 = MPT(14,MI)
  CA = MPT(10,MI)
  CB = MPT(11,MI)
  CCT= MPT(12,MI)
  CD = MPT(13,MI)

  !---- Eq.6 and Eq.7: E(T), nu(T). |T| only acts in frozen soil.
  MPTEMP
  *DO,J,1,NT
    MPTEMP,J,TPT(J)
  *ENDDO
  *DO,J,1,NT
    TJ = TPT(J)
    TA = 0
    *IF,TJ,LT,0,THEN
      TA = -TJ
    *ENDIF
    EV = A1*1e6
    *IF,TA,GT,0,THEN
      EV = (A1+B1*TA**M_E)*1e6
    *ENDIF
    MPDATA,EX,MI,J,EV
    MPDATA,PRXY,MI,J,A2+B2*TA
  *ENDDO

  !---- Eq.4: total thermal strain THSY = 0 frozen, -alpha thawed.
  !     REFT sets where the strain is zero:
  !       frozen (T_FRZ) -> strain = -alpha whenever the soil is thawed
  !       thawed (+1)    -> soil thawed at t = 0 starts strain-free
  MPTEMP
  MPTEMP,1,-50,THS_1,THS_2,50
  MPDATA,THSY,MI,1,0,0,-DELA,-DELA
  *IF,VERT_ONLY,EQ,1,THEN
    MPDATA,THSX,MI,1,0,0,0,0
    MPDATA,THSZ,MI,1,0,0,0,0
  *ELSE
    MPDATA,THSX,MI,1,0,0,-DELA,-DELA
    MPDATA,THSZ,MI,1,0,0,-DELA,-DELA
  *ENDIF
  *IF,THAW_REF,EQ,1,AND,THW0,EQ,1,THEN
    MP,REFT,MI,1.0
  *ELSE
    MP,REFT,MI,T_FRZ
  *ENDIF

  !---- Eq.8 and Eq.9: c(T), phi(T) -> Drucker-Prager matched to
  !     Mohr-Coulomb in plane strain:
  !     alpha = 3*sqrt3*tan(phi)/sqrt(9+12tan^2), sigY = 3*sqrt3*c/sqrt(..)
  TB,EDP,MI,NT,,LYFUN
  *DO,J,1,NT
    TJ = TPT(J)
    TA = 0
    *IF,TJ,LT,0,THEN
      TA = -TJ
    *ENDIF
    CC = (A3+B3*TA)*1e6
    *IF,CC,LT,C_MIN,THEN
      CC = C_MIN
    *ENDIF
    PHI = A4+B4*TA
    *IF,PHI,GT,PHI_MX,THEN
      PHI = PHI_MX
    *ENDIF
    TN = TAN(PHI*PI/180)
    RT = SQRT(9+12*TN*TN)
    TBTEMP,TPT(J)
    TBDATA,1,3*SQRT(3)*TN/RT,3*SQRT(3)*CC/RT
  *ENDDO
  TB,EDP,MI,NT,,LFPOT        ! flow potential: zero dilatancy
  *DO,J,1,NT
    TBTEMP,TPT(J)
    TBDATA,1,0.0
  *ENDDO

  !---- Eq.5 creep, frozen soil only. Differentiating Eq.5 gives the
  !     ANSYS time-hardening law (TBOPT=2):
  !       d(eps)/dt = C1 s^C2 t^C3 e^(-C4/T)
  !       C1 = A*C*SIG_U^-B*TIM_U^-C*exp(D/|T|), C2 = B, C3 = C-1, C4 = 0
  !     exp(-D/T) is folded into C1(T) so the law is off in thawed soil.
  *IF,USE_CREEP,EQ,1,THEN
    TB,CREEP,MI,NT,4,2
    *DO,J,1,NT
      C1V = 0
      TJ = TPT(J)
      *IF,TJ,LT,0,THEN
        TA = -TJ
        *IF,TA,LT,T_CLMP,THEN
          TA = T_CLMP
        *ENDIF
        C1V = CA*CCT*SIG_U**(-CB)*TIM_U**(-CCT)*EXP(CD/TA)
      *ENDIF
      TBTEMP,TPT(J)
      TBDATA,1,C1V,CB,CCT-1,0
    *ENDDO
  *ENDIF
*ENDDO

! concrete abutment / foundation (mat 7)
MP,EX,7,25e9
MP,PRXY,7,0.167
MP,ALPX,7,1.0e-5
MP,REFT,7,2.0
! crushed-rock cooling layer (mat 11), elastic, no thaw strain
MP,EX,11,CR_E
MP,PRXY,11,0.30

!======================= boundary conditions ============================
! paper: sides fixed horizontally, bottom fixed vertically, surfaces free
ALLSEL,ALL
NSEL,S,LOC,X,XL
D,ALL,UX,0
NSEL,S,LOC,X,15
D,ALL,UX,0
NSEL,S,LOC,Y,YB
D,ALL,UY,0
ALLSEL,ALL
*IF,SEAT_FIX,EQ,1,THEN     ! bridge seat, y = 6, x = -1.5 ... 0
  ESEL,S,MAT,,7
  NSLE,S
  NSEL,R,LOC,Y,6
  NSEL,R,LOC,X,-1.5,0
  D,ALL,UX,0
  ALLSEL,ALL
*ENDIF
ACEL,0,9.81,0              ! gravity (acts in -y)
TREF,0
FINISH

!=========================== solution ===================================
/SOLU
ANTYPE,STATIC
NLGEOM,OFF
NROPT,UNSYM                ! friction 0.3-0.6
AUTOTS,ON
LNSRCH,ON
NEQIT,50
PRED,ON
KBC,0
OUTRES,ERASE
OUTRES,ALL,LAST
*IF,STAB,EQ,1,THEN
  STABILIZE,CONSTANT,ENERGY,1e-4
*ENDIF
CNCHECK,SUMMARY            ! prints the initial status of every contact pair
                           ! (bonded pairs must be CLOSED)

ALLSEL,ALL
*GET,NMAX,NODE,0,NUM,MAX
*DEL,TMAX
*DEL,SOILN
*DIM,TMAX,ARRAY,NMAX
*DIM,SOILN,ARRAY,NMAX
ESEL,S,MAT,,1,5
ESEL,A,MAT,,11
NSLE,S
*VGET,SOILN(1),NODE,1,NSEL           ! 1 = soil node, concrete nodes -1/0
ALLSEL,ALL

!---- LS1: geostatic. Only the natural ground has weight. Soil sits at a
!     frozen temperature (thaw strain 0), concrete at its initial field.
RATE,OFF
MP,DENS,5,1e-3
MP,DENS,7,1e-3
MP,DENS,11,1e-3
*DO,I,1,NMAX
  *IF,NSEL(I),EQ,1,THEN
    YY = NY(I)
    TT0 = ICT(YY)
    *IF,SOILN(I),GT,0,AND,THAW_REF,EQ,0,THEN
      BF,I,TEMP,T_FRZ
    *ELSE
      BF,I,TEMP,TT0
    *ENDIF
  *ENDIF
*ENDDO
TIME,0.5
NSUBST,5,100,2
SOLVE

!---- LS2: construction loads - embankment + abutment weight, pavement
!     and traffic. Temperatures stay as in LS1 (loads and thaw strain are
!     applied in separate steps, which converges much more easily).
MP,DENS,5,2060
MP,DENS,7,2500
MP,DENS,11,1600
LSEL,S,,,55,56             ! embankment top
*IF,LOAD_CAP,EQ,1,THEN
  LSEL,A,,,2               ! road surface over the abutment cap
*ENDIF
NSLL,S,1
SF,ALL,PRES,Q_TRAF
ALLSEL,ALL
TIME,0.75
NSUBST,20,400,10
SOLVE

!---- LS3: end of construction - initial temperature profile ICT
!     (the thermal IC): thawed active layer and fill take their thaw
!     strain and thawed properties here
*DO,I,1,NMAX
  *IF,NSEL(I),EQ,1,THEN
    YY = NY(I)
    TT0 = ICT(YY)
    BF,I,TEMP,TT0
    TMAX(I) = TT0
  *ENDIF
*ENDDO
TIME,1
NSUBST,20,400,10
SOLVE

!---- LS4...: monthly temperature fields from the thermal run
*IF,USE_CREEP,EQ,1,THEN
  RATE,ON
  CUTCONTROL,CRPLIMIT,1.0,1
*ENDIF
*DO,IM,MSTEP,NMON,MSTEP
  TNOW = IM*730
  LDREAD,TEMP,,,TNOW,,'THERMAL','rth'
  *IF,IRREV,EQ,1,THEN
    *DO,I,1,NMAX
      *IF,SOILN(I),GT,0,THEN
        *GET,TN0,NODE,I,BF,TEMP
        *IF,TN0,GT,TMAX(I),THEN
          TMAX(I) = TN0
        *ENDIF
        BF,I,TEMP,TMAX(I)
      *ENDIF
    *ENDDO
  *ENDIF
  TIME,TNOW
  NSUBST,5,200,2
  SOLVE
*ENDDO
SAVE
FINISH
! next: /INPUT,'03_extract_results','mac'
