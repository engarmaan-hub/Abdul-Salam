!=======================================================================
! 01_thermal_transient.mac
! Sequential thermo-mechanical analysis - STEP 1 (transient thermal)
! Writes THERMAL.db and THERMAL.rth, which 02_mechanical_settlement.mac
! and 03_extract_results.mac read.
! Changes from the original script are marked  !>>> FIX
!   FIX 1  fixed jobname THERMAL
!   FIX 2  geothermal flux applied at the real bottom, paper value 0.02 W/m2
!   FIX 3  model depth 30 m (paper Table 2: mudstone 8-30 m)
!   FIX 4  embankment extended behind the abutment (XL) so that the
!          0-20 m range of Fig. 14 is clear of the far boundary
!   FIX 5  soil layers assigned by element centroid (Table 2 depths),
!          no hard-coded element numbers (they change with the mesh)
!   FIX 6  mat 4 latent-heat peak at -0.2..0 degC restored (FIX_M4)
!   FIX 7  crushed-rock layer OFF by default: the paper has no measure
!   FIX 8  mechanical tables removed (built in step 2 from Table 3)
!   FIX 9  conformal concrete/soil interfaces: the soft LESIZE divisions
!          of the trapezoidal abutment areas (3, 4) could not be mapped,
!          the mesher changed them, and the change spread into the footing
!          bottom (concrete 19 vs soil 15 divisions) and the front face.
!          Areas 3, 4 are now free-meshed and interface lines have hard
!          divisions, so every concrete interface node has a soil twin.
!=======================================================================
/clear
/FILNAME,THERMAL,1   !>>> FIX 1: fixed jobname, read by steps 2 and 3
/prep7
*AFUN,RAD
PI=3.14159265358979
USE_CR    = 0        !>>> FIX 7: 0 = paper case (no measure), 1 = crushed rock
CR_TOP    = 6.0      ! layer top    (y, m)  -> 1.0 m below embankment top (y=7)
CR_BOT    = 4.5      ! layer bottom (y, m)  -> 1.5 m thick
CR_KS     = 1620     ! crushed rock k, warm season  (0.45 W/m.K)
CR_KW     = 8100     ! equivalent k, cold season (convection), about 5x CR_KS
EMB_MEAN  = 1.5      ! mean annual embankment-surface temperature (original 1.5)
EMB_AMP   = 12.5     ! annual amplitude of embankment surface
NYEAR     = 5        ! simulated years (paper: 15; 5 for this stage)
QGEO      = 72       !>>> FIX 2: 0.02 W/m2 = 72 J/m2.h (paper); was 131
XL        = -50      !>>> FIX 4: left end of model (abutment back face ~ x=-6.2)
YB        = -30      !>>> FIX 3: model bottom, 30 m below natural ground
FIX_M4    = 1        !>>> FIX 6: 1 = restore mat 4 latent peak, 0 = original

et,1,plane55
keyopt,1,3,0
ET,2,CONTA172
KEYOPT,2,1,2
ET,3,TARGE169
!!!!!!!!! material properties
mptemp,1,-20,-10.01,-10,-5.01,-5,-3.01
mptemp,7,-3,-2.01,-2,-1.01,-1,-0.51
mptemp,13,-0.5,-0.21,-0.2,0,0.01,40
 
