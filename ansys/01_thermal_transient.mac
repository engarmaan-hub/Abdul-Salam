mpdata,c,2,13,14212,14212,99886,99886,1044,1044

mpdata,c,3,1,1222,1222,1737,1737,2702,2702
mpdata,c,3,7,6640,6640,6678,6678,11864,11864
mpdata,c,3,13,35903,35903,130278,130278,1608,1608

