!>>> CHANGED: embankment surface, mean & amplitude now parameters
!    EMB_MEAN + EMB_AMP sin(2 pi t/8760 + pi) + 5.94e-6 t
*DEL,_FNCNAME
*DEL,_FNCMTID
*DEL,_FNCCSYS
*SET,_FNCNAME,'lumian'
*SET,_FNCCSYS,0
*DIM,%_FNCNAME%,TABLE,6,17,1,,,,%_FNCCSYS%
*SET,%_FNCNAME%(0,0,1), 0.0, -999
*SET,%_FNCNAME%(2,0,1), 0.0
*SET,%_FNCNAME%(3,0,1), 0.0
*SET,%_FNCNAME%(4,0,1), 0.0
*SET,%_FNCNAME%(5,0,1), 0.0
*SET,%_FNCNAME%(6,0,1), 0.0
*SET,%_FNCNAME%(0,1,1), 1.0, -1, 0, 2, 0, 0, 0
*SET,%_FNCNAME%(0,2,1), 0.0, -2, 0, 3.14159265358979310, 0, 0, -1
*SET,%_FNCNAME%(0,3,1),   0, -3, 0, 1, -1, 3, -2
*SET,%_FNCNAME%(0,4,1), 0.0, -1, 0, 1, -3, 3, 1
*SET,%_FNCNAME%(0,5,1), 0.0, -2, 0, 8760, 0, 0, -1
*SET,%_FNCNAME%(0,6,1), 0.0, -3, 0, 1, -1, 4, -2
*SET,%_FNCNAME%(0,7,1), 0.0, -1, 0, 3.14159265358979310, 0, 0, -3
*SET,%_FNCNAME%(0,8,1), 0.0, -2, 0, 1, -3, 1, -1
*SET,%_FNCNAME%(0,9,1), 0.0, -1, 9, 1, -2, 0, 0
*SET,%_FNCNAME%(0,10,1), 0.0, -2, 0, EMB_AMP, 0, 0, -1
*SET,%_FNCNAME%(0,11,1), 0.0, -3, 0, 1, -2, 3, -1
*SET,%_FNCNAME%(0,12,1), 0.0, -1, 0, EMB_MEAN, 0, 0, -3
*SET,%_FNCNAME%(0,13,1), 0.0, -2, 0, 1, -1, 1, -3
*SET,%_FNCNAME%(0,14,1), 0.0, -1, 0, 0.00000594, 0, 0, 1
*SET,%_FNCNAME%(0,15,1), 0.0, -3, 0, 1, -1, 3, 1
*SET,%_FNCNAME%(0,16,1), 0.0, -1, 0, 1, -2, 1, -3
*SET,%_FNCNAME%(0,17,1), 0.0, 99, 0, 1, -1, 0, 0
 
!===================== boundary conditions ==============================

!    surface function. It is natural ground, so it gets DIBIAO.
allsel,all
lsel,s,,,27,28,1
nsll,s,1
D,ALL,TEMP,%dibiao%
 
! exposed abutment concrete faces (lines 1,2,11,12) 
allsel,all
lsel,s,,,1,2,1
lsel,a,,,11,12,1
nsll,s,1
D,ALL,TEMP,%qiaotai%
 
!embankment top, line 55 + line 56 (backfill wedge top)
allsel,all
lsel,s,,,55,56,1
nsll,s,1
D,ALL,TEMP,%lumian%
 
! geothermal flux at the bottom
!>>> FIX 2: the original "nsel,s,loc,y,-28" selected no nodes (bottom was
!    y=-20), so no flux was applied. Now at the real bottom, paper value.
allsel,all
nsel,s,loc,y,YB
SF,ALL,HFLUX,QGEO
 
!===================== initial temperature ==============================
!>>> CHANGED: one continuous profile T(y) interpolated at every node
!    (same values as the original step list, but with no gaps)
*DEL,ICT
*DIM,ICT,TABLE,27,1
*TAXIS,ICT(1),1,-30,-16,-15,-14,-13,-12,-11,-10,-9,-8
*TAXIS,ICT(11),1,-7,-6,-5,-4,-3,-2,-1.75,-1,-0.75,-0.5
*TAXIS,ICT(21),1,-0.25,0,0.25,4,4.25,7,10
ICT(1,1)=-0.25,-0.25,-0.27,-0.29,-0.31,-0.33,-0.36,-0.41,-0.45,-0.50
ICT(11,1)=-0.55,-0.60,-0.65,-0.69,-0.80,-0.80,0.20,0.20,0.25,0.25
ICT(21,1)=1.0,1.0,2.0,2.0,3.0,3.0,3.0
allsel,all
*GET,NMAX,NODE,0,NUM,MAX
*DO,I,1,NMAX
  *IF,NSEL(I),EQ,1,THEN
    YY=NY(I)
    TT=ICT(YY)
    IC,I,TEMP,TT
  *ENDIF
*ENDDO
allsel,all
finish
 
!===================== solution =========================================
/config,nres,200000
/solu
antype,trans
AUTOTS,1
KBC,0
TSRES,ERASE
NEQIT,100
TIMINT,1
TINTP,0.009, , ,1,0.5,-1
CNVTOL,TEMP, ,,2,
LNSRCH,1
PRED,ON,,ON
outres,all,5            ! every 5th substep + last substep of every month
                        ! (steps 2 and 3 read the month-end sets)
! Clock: t = 0 is mid-October (surface T = mean and falling), so
!   October of year N = N*8760 h (max thaw depth), April = N*8760-4380 h
 

*SET,NMON,NYEAR*12
*DO,IM,1,NMON
  TEND = IM*730
  TMID = TEND-365
  TSURF = EMB_MEAN+EMB_AMP*SIN(2*PI*TMID/8760+PI)+0.00000594*TMID
  *IF,USE_CR,EQ,1,THEN
    *IF,TSURF,LT,0,THEN
      MP,KXX,11,CR_KW
    *ELSE
      MP,KXX,11,CR_KS
    *ENDIF
  *ENDIF
  TIME,TEND
  DELTIM,1,0.01,24
  allsel,all
  SOLVE
*ENDDO
save
finish
